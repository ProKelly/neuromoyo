# Copy this file to .env and fill in your own values. Never commit .env.
# After editing this file, RESTART the backend process -- settings are only
# read once at startup, so a running `uvicorn --reload` won't pick up .env
# changes on its own (--reload only watches Python files).

# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" connection string for serverless/short-lived connections,
# or the direct connection string for a long-running backend process.
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
# Project Settings -> API -> Project URL. REQUIRED for two things:
#  1. Verifying clinician session tokens -- most Supabase projects sign tokens
#     with ES256 and publish the public key at
#     `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`, verified automatically
#     (see app/auth.py). No secret needed for this.
#  2. Sending clinician invite emails via Supabase's Admin API (see below).
SUPABASE_URL=https://[project-ref].supabase.co

# REQUIRED for clinician onboarding (POST /api/clinicians/invite -- see
# app/supabase_admin.py). Project Settings -> API -> service_role key.
# This grants full admin access to your whole Supabase project -- NEVER expose
# it to the frontend, never commit it, backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for an OLDER project (or one with legacy signing explicitly enabled)
# that signs tokens with a single HS256 shared secret instead of ES256/JWKS.
# Project Settings -> API -> JWT Settings -> "Legacy JWT Secret" (click Reveal).
# Leave blank if you're not sure -- SUPABASE_URL/JWKS covers the default case, and
# app/auth.py's own error message will tell you clearly if you actually need this.
SUPABASE_JWT_SECRET=

# --- App ---
ENVIRONMENT=development
# Comma-separated list in production, e.g. https://neuromoyo.vercel.app
CORS_ORIGINS=*

# Public URL of the FRONTEND (not this backend). Used to build the redirect
# link in clinician invite emails -- MUST also be added to Supabase's
# Authentication -> URL Configuration -> Redirect URLs allow-list, or Supabase
# silently ignores it and the invite link goes nowhere useful.
FRONTEND_URL=http://localhost:3000

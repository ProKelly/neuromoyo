# Copy this file to .env and fill in your own values. Never commit .env.

# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" connection string for serverless/short-lived connections,
# or the direct connection string for a long-running backend process.
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional: only needed if the backend later calls Supabase's own client/storage APIs
# directly (rather than just the Postgres connection above). Get these from
# Project Settings -> API. NEVER expose the service_role key to the frontend.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Auth ---
# Project Settings -> API -> JWT Settings -> "Legacy JWT Secret" (HS256).
# Verifying with this shared secret is done locally (no network round-trip per
# request). If your project only shows an asymmetric signing key (newer
# Supabase projects default to ES256 + JWKS), open "Legacy JWT Secret" in the
# same panel and click "Reveal" / enable it -- it still works alongside the
# new keys and is far simpler to verify from a single backend service.
SUPABASE_JWT_SECRET=

# --- App ---
ENVIRONMENT=development
# Comma-separated list in production, e.g. https://neuromoyo.vercel.app
CORS_ORIGINS=*

# Copy to .env. Points the Nuxt app at the FastAPI backend.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Supabase project (Project Settings -> API). The anon key is public-safe by
# design -- it's meant to ship in frontend bundles; Supabase Auth + row access
# is what actually gates data, not secrecy of this key.
NUXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
